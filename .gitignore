!rag-thesis-backend/migrations/
!rag-thesis-backend/migrations/*.sql

# Local test and analysis artifacts
coverage.json
rag-thesis-frontend/coverage/
tmp/
*-trivy.txt
.pnpm-store/
tmp-pylint-cache/
tmp-pytest-*/
tmp-review-*/
# Loose scratch files, not just scratch directories: one-off rollback
# records written before a live data change (tmp-release-backup.json,
# tmp-authors-backup.json) sat untracked next to the source because every
# pattern above ends in a slash.
tmp-*.json
# ...and the verification logs that came with them: tmp-audit-*.log sat
# tracked at the repo root from 4847209 until 2026-09-14, referenced by
# nothing and carrying an absolute path from the machine that wrote them.
tmp-*.log
# One-off reproduction scripts. `_repro2_tmp.py` -- a script that provisions a
# throwaway Supabase admin user to reproduce an auth bug -- was committed on
# 2026-09-14 by a `git add -A` because every pattern above requires a leading
# "tmp". These name the machine's own paths and create real accounts; they are
# never part of the artifact.
_repro*
*_tmp.py
tmp_*.py
rag-thesis-backend/.venv*/
rag-thesis-backend/.pylint-cache-*/
rag-thesis-backend/.pytest-*/

# Supabase local backup
supabase/

# PI-08 controlled records. Never commit signatures, approval scans, or the
# identifiable working corpus register. Commit only templates and redacted
# hash receipts intended for the release evidence bundle.
docs/governance/private/
rag-thesis-backend/evaluation/corpus/private/
