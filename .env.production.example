# Production backend env for docker-compose.prod.yml.
# Copy to rag-thesis-backend/.env.production on the server. NEVER commit the real file.
APP_ENVIRONMENT=production

GEMINI_API_KEY=your-paid-gemini-key
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_VERDICT_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

CORS_ORIGINS=https://your-app.vercel.app

# Required by config.validate_production_services
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
MALWARE_SCAN_MODE=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
REQUIRE_PRIVILEGED_MFA=true
GUEST_DAILY_TOKEN_BUDGET=200000

# Caddy reaches the API over the compose bridge network
FORWARDED_ALLOW_IPS=172.16.0.0/12

OPERATIONS_MONITOR_ENABLED=true
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
