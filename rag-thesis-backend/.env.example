# ============================================================
# ISU Thesis AI Library — backend environment configuration
# Copy to .env and fill in the values. NEVER commit .env.
# ============================================================

# Google Gemini API key (embeddings + LLM synthesis)
GEMINI_API_KEY=your-gemini-api-key

# Optional reserve API keys, comma-separated. Tried in order ONLY after the
# primary key above reports exhaustion, so a room of people demoing the chat
# does not stall on one free-tier quota. Leave empty for the single-key
# behaviour, which is what development and the evaluation runs use.
#
# Each key must be a separately-owned allowance used with its owner's consent
# (a co-researcher's key, or the department's). Extra accounts minted to
# multiply one person's free tier breach the provider's terms, and every
# unpaid key carries the same data-use restriction, so a pool buys throughput
# and never legal headroom.
# GEMINI_API_KEYS=second-key,third-key
# GEMINI_KEY_COOLDOWN_SECONDS=60

# Optional OpenAI-compatible gateway for the CHAT models only (chat, extract,
# and verdict calls). When LLM_BASE_URL is set, those calls are routed here
# first and fall back to Google on any failure; the model names above are sent
# unchanged, so a gateway serving `gemini-3.6-flash` runs the same model the
# paper evaluates and only the network route differs.
#
# Embeddings are NEVER routed. The pgvector column is vector(768) under a CHECK
# constraint and match_chunks filters on the recorded embedding model, so a
# different embedding source returns zero results until every paper is
# reindexed. Every question therefore still makes one call to Google.
#
# Governance: a gateway is a third party. The no-training guarantee the paper
# relies on (Section 2.1.6) comes from Google's Gemini API terms and does NOT
# extend to another operator. Leave this unset for the formal evaluation and
# for any run whose prompts contain governed corpus text, unless the gateway
# operator is covered by its own reviewed agreement. The release fingerprint
# records whether it was enabled (scripts/release_fingerprint.py).
# LLM_BASE_URL=https://gateway.example/v1
# LLM_API_KEY=gateway-credential

# Cap on one generated answer. config.py is authoritative at 700; leave this
# unset unless a deployment genuinely needs a different cap, because an .env
# value silently overrides the default and the release fingerprint then records
# whichever the process loaded. 700 tokens is roughly 500 words, enough for a
# multi-paragraph cited answer; 500 truncated some of them mid-sentence.
# GEMINI_MAX_OUTPUT_TOKENS=700


# Supabase project
SUPABASE_URL=https://your-project.supabase.co
# IMPORTANT: use the SERVICE_ROLE key here (the backend bypasses RLS).
# The anon key belongs in the frontend .env only.
SUPABASE_KEY=your-service-role-key

# --- Optional overrides (defaults shown) ---
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# To use Gemini 3.7 Flash instead, replace the active line above with:
# GEMINI_CHAT_MODEL=gemini-3.7-flash
# GEMINI_VERDICT_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=models/gemini-embedding-001
# Gemini 3.7 Flash can take longer than the old 25-second default for a
# full RAG prompt, especially when thinking is enabled.
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_THINKING_LEVEL=low
# CORS_ORIGINS=http://localhost:5173,https://thesis.isu.edu.ph
# MAX_UPLOAD_MB=25
# MAX_PDF_PAGES=500
# DUPLICATION_THRESHOLD=0.85
# RETRIEVAL_THRESHOLD=0.30
# RETRIEVAL_MATCH_COUNT=5
# THESIS_EVALUATION_DEPARTMENT=CCSICT
# APP_ENVIRONMENT=development
# Local development may use memory://. Production must use Redis and a shared URI.
# RATE_LIMIT_STORAGE_URI=memory://
# Production example: redis://127.0.0.1:6379/0
# RATE_LIMIT_CHAT=30/minute
# RATE_LIMIT_CHAT_IP=300/minute
# RATE_LIMIT_SCAN=5/minute
# RATE_LIMIT_FOLLOWUP=20/minute
# Global ceiling on a day's total guest research spend, in tokens. The rate
# limits above bound how fast one caller can ask; this bounds the aggregate, so
# a distributed script with valid Turnstile challenges cannot drain the shared
# Gemini quota and take chat down for signed-in users. Counted per UTC day in
# the RATE_LIMIT_STORAGE_URI store, so replicas share one budget.
# 0 = unlimited (development, tests, evaluation runs). Production must set a
# real number; the config validator refuses to start otherwise. As a starting
# point, the worst case is under 5,000 tokens per question (top-5 retrieval x
# 800-token chunks, plus GEMINI_MAX_OUTPUT_TOKENS), so 2,000,000 is roughly 400
# guest questions a day even if every one retrieves a full context.
# GUEST_DAILY_TOKEN_BUDGET=0
# Durable ingestion worker (run separately with: python -m workers.ingestion_worker)
# INGESTION_POLL_SECONDS=2
# INGESTION_LEASE_SECONDS=120
# INGESTION_HEARTBEAT_SECONDS=30
# INGESTION_MAX_ATTEMPTS=3
# INGESTION_MAINTENANCE_SECONDS=300
# Malware scanning: production requires clamav; development may explicitly disable it.
# MALWARE_SCAN_MODE=disabled
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_SECONDS=30
# OPERATIONS_MONITOR_ENABLED=true
# OPERATIONS_MONITOR_SECONDS=30
# OPERATIONS_WORKER_STALE_SECONDS=90
# OPERATIONS_QUEUE_AGE_SECONDS=300
# OPERATIONS_QUEUE_DEPTH_THRESHOLD=10
# OPERATIONS_CLEANUP_AGE_SECONDS=600
# Disaster-recovery targets. BACKUP_RPO_HOURS doubles as the staleness threshold:
# when the newest backup recorded by scripts/scheduled_backup.ps1 is older than
# this, the operations monitor raises a `backup_stale` alert. 0 disables the
# check, which is the default so a deployment that has not registered the nightly
# task yet is not permanently alerting. 24 is the pilot commitment in §8.1.
# BACKUP_RPO_HOURS=24
# The restore target a drill is measured against. Recorded, not enforced --
# nothing in the API can verify it. See docs/BACKUP_RESTORE_DRILL.md.
# BACKUP_RTO_HOURS=4
# Optional signed HTTPS webhook (both values are required together).
# OPERATIONS_ALERT_WEBHOOK_URL=https://alerts.example.edu/ingestion
# OPERATIONS_ALERT_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Automatic deletion remains disabled until institutional approval.
# RETENTION_ENFORCEMENT_ENABLED=false
# Production must require aal2 tokens for admin and superadmin API access.
# Production must use true. Local development may use false until MFA is enrolled.
# REQUIRE_PRIVILEGED_MFA=true
# Set only to the hosting platform's known proxy IP/CIDR; never use * publicly.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Optional: Cloudflare Turnstile guard for guest chat. When set, unauthenticated
# /chat callers must pass one Turnstile challenge per guest session before any
# Gemini quota is spent. Pair with VITE_TURNSTILE_SITE_KEY in the frontend .env.
# Leave unset to keep guest chat open (development, tests, evaluation runs).
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# TURNSTILE_VERIFY_TIMEOUT_SECONDS=5
# TURNSTILE_GUEST_TTL_SECONDS=3600
# Reject tokens minted for a different widget or solved on another site.
# Set the hostname allowlist once the public domain is final; empty skips it.
# TURNSTILE_EXPECTED_ACTION=guest_chat
# TURNSTILE_ALLOWED_HOSTNAMES=thesis.isu.edu.ph

# Optional: Supabase legacy JWT secret (Dashboard -> Project Settings -> API
# -> JWT Settings). When set, rate limiting keys on the verified user id
# instead of the client IP — recommended in production so students behind
# one campus NAT get individual quotas.
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Optional LangSmith tracing (Performance Efficiency evaluation) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key
# LANGCHAIN_PROJECT=isu-thesis-library
# Current LangSmith names (legacy LANGCHAIN_* aliases remain supported)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=isu-thesis-library
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# --- Disposable Supabase integration tests only ---
# Never point these values at the configured application/production project.
# ALLOW_DISPOSABLE_SUPABASE_TESTS=0
# TEST_SUPABASE_URL=https://your-disposable-project.supabase.co
# TEST_SUPABASE_PROJECT_REF=your-disposable-project
# TEST_SUPABASE_ANON_KEY=your-disposable-anon-key
# TEST_SUPABASE_SERVICE_ROLE_KEY=your-disposable-service-role-key
